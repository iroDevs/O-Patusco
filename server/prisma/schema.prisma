generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


enum Role {
  MEDICO
  RECEPCIONISTA
  ATENDENTE
  ADMIN
}

enum PetType {
  CACHORRO
  GATO
  PASSARO
  REPTIL
  PEIXE
  ROEDOR
  OUTRO
}

enum TaskStatus {
  FINALIZADO
  PENDENTE
  CANCELADO
  FALTANTE
}

model Client {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  phone       String?
  name        String
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pets       Pet[]
  tasks      Task[]

  @@map("clients")
}

model Pet {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  type      PetType
  age       Int
  description String?
  image     String?
  ownerId   Int
  owner     Client   @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@map("pets")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  senha     String
  name      String
  phone     String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  client_id   Int
  status      TaskStatus
  time        DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  client     Client     @relation(fields: [client_id], references: [id])
  @@map("tasks")
}